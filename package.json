{
  "name": "special-chess-3d",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "server": "node server/index.mjs",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "dev:offline": "vite --config vite.offline.config.ts --host 0.0.0.0",
    "build:offline": "tsc && vite build --config vite.offline.config.ts && node scripts/package-offline.mjs",
    "test:offline": "node tests/offline-browser.mjs",
    "build:pages": "npm run build:offline && node scripts/package-pages.mjs",
    "test:pages": "node tests/pages-browser.mjs",
    "test:render": "node tests/render-browser.mjs",
    "test:title": "node tests/title-browser.mjs",
    "test:hud": "node tests/hud-browser.mjs",
    "test:army": "node tests/army-browser.mjs",
    "test:audio": "node tests/audio-browser.mjs",
    "test:showcase": "node tests/showcase-browser.mjs",
    "test:economy": "node tests/economy-browser.mjs",
    "test:daily": "node tests/daily-browser.mjs",
    "test:tactics": "node tests/tactics-browser.mjs",
    "test:freestyle": "node tests/freestyle-browser.mjs",
    "test:special": "node tests/special-browser.mjs",
    "test:modes": "node tests/modes-browser.mjs",
    "test:player": "node tests/player-browser.mjs",
    "test:deploy": "node scripts/test-deploy.mjs",
    "test:duel-draft": "node tests/duel-draft-browser.mjs",
    "test:execution": "node tests/execution-browser.mjs",
    "test:friend-duel": "node tests/friend-duel-browser.mjs",
    "test:friend-deploy": "node scripts/test-friend-deploy.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "three": "^0.180.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
