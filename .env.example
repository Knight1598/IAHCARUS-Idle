# Copy to .env on the host and replace this example with the real HTTPS origin.
# The frontend, /api/account/* and /ws must use this same origin.
ACCOUNT_PUBLIC_ORIGIN=https://your-game-domain.example
GAME_HOST_PORT=3000

# Optional guest-only private-duel server for the existing GitHub Pages game.
# GUEST_DUEL_ONLY=true disables account registration/storage on this service.
# GUEST_DUEL_ONLY=true
# DUEL_ALLOWED_ORIGINS=https://knight1598.github.io
# CHESS_CLOCK_MS=300000
